{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=driver",
  "name": "dameng",
  "version": "1.0.1",
  "description": "DM / Dameng database driver for Tabularis using a user-provided JDBC driver.",
  "category": "database",
  "kind": "driver",
  "engine": "dameng",
  "paradigms": ["relational"],
  "tags": ["dameng", "dm", "database", "jdbc", "sql", "driver"],
  "license": "Apache-2.0",
  "icon": "assets/icon.svg",
  "readme": "README.md",
  "readmes": {
    "zh-CN": "README.zh-CN.md"
  },
  "documentation_url": "https://github.com/haos666/tabularis-dameng-plugin/blob/main/README.md",
  "homepage": "https://github.com/haos666/tabularis-dameng-plugin",
  "support": {
    "issues_url": "https://github.com/haos666/tabularis-dameng-plugin/issues"
  },
  "min_runtime_version": "0.13.1",
  "color": "#0f766e",
  "default_port": 5236,
  "default_username": "SYSDBA",
  "executable": "dameng-plugin",
  "is_builtin": false,
  "capabilities": {
    "schemas": true,
    "views": true,
    "routines": true,
    "triggers": true,
    "file_based": false,
    "folder_based": false,
    "connection_string": true,
    "connection_string_example": "jdbc:dm://localhost:5236",
    "identifier_quote": "\"",
    "alter_primary_key": false,
    "alter_column": true,
    "create_foreign_keys": true,
    "manage_tables": true,
    "readonly": false,
    "auto_increment_keyword": "IDENTITY(1,1)"
  },
  "settings": [
    {
      "key": "jdbc_driver_path",
      "label": "Dameng JDBC Driver Path",
      "type": "string",
      "required": true,
      "description": "Absolute path to a local DmJdbcDriver jar, for example /path/to/DmJdbcDriver8.jar."
    },
    {
      "key": "connect_timeout_ms",
      "label": "Connect Timeout (ms)",
      "type": "number",
      "description": "Connection timeout passed to the Dameng JDBC driver."
    },
    {
      "key": "query_timeout_sec",
      "label": "Query Timeout (sec)",
      "type": "number",
      "description": "Maximum time a statement may run before JDBC cancels it."
    }
  ],
  "data_types": [
    { "name": "INT", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "INTEGER", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "SMALLINT", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "TINYINT", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "BIGINT", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "DECIMAL", "category": "numeric", "requires_length": false, "requires_precision": true },
    { "name": "NUMERIC", "category": "numeric", "requires_length": false, "requires_precision": true },
    { "name": "NUMBER", "category": "numeric", "requires_length": false, "requires_precision": true },
    { "name": "FLOAT", "category": "numeric", "requires_length": false, "requires_precision": true },
    { "name": "REAL", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "DOUBLE", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "DOUBLE PRECISION", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "BIT", "category": "numeric", "requires_length": false, "requires_precision": false },
    { "name": "VARCHAR", "category": "string", "requires_length": true, "requires_precision": false, "default_length": "255" },
    { "name": "NVARCHAR", "category": "string", "requires_length": true, "requires_precision": false, "default_length": "255" },
    { "name": "CHAR", "category": "string", "requires_length": true, "requires_precision": false, "default_length": "1" },
    { "name": "NCHAR", "category": "string", "requires_length": true, "requires_precision": false, "default_length": "1" },
    { "name": "TEXT", "category": "string", "requires_length": false, "requires_precision": false },
    { "name": "LONGVARCHAR", "category": "string", "requires_length": false, "requires_precision": false },
    { "name": "DATE", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "DATETIME", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "TIME", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "TIMESTAMP", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "INTERVAL YEAR TO MONTH", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "INTERVAL DAY TO SECOND", "category": "date", "requires_length": false, "requires_precision": false },
    { "name": "VARBINARY", "category": "binary", "requires_length": true, "requires_precision": false, "default_length": "255" },
    { "name": "LONGVARBINARY", "category": "binary", "requires_length": false, "requires_precision": false },
    { "name": "BLOB", "category": "binary", "requires_length": false, "requires_precision": false },
    { "name": "IMAGE", "category": "binary", "requires_length": false, "requires_precision": false },
    { "name": "BFILE", "category": "binary", "requires_length": false, "requires_precision": false },
    { "name": "CLOB", "category": "string", "requires_length": false, "requires_precision": false },
    { "name": "BOOLEAN", "category": "other", "requires_length": false, "requires_precision": false }
  ]
}
